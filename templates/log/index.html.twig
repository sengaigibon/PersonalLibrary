{% extends 'base.html.twig' %}

{% block title %}ReadLog index{% endblock %}

{% block body %}
<div class="books-container">
    <div class="books-header">
        <h1>📖 Reading Log</h1>
        <a href="{{ path('app_read_log_new', {page: pagination.current_page|default(1), limit: pagination.items_per_page|default(20)}) }}" class="btn-base btn-new">+ Add New Entry</a>
    </div>

    <div class="search-container">
        <form method="GET" action="{{ path('app_dashboard_reading_log') }}" class="search-form">
            <div class="search-fields">
                <div class="search-field">
                    <label for="title">Search by Title:</label>
                    <input type="text" id="title" name="title" value="{{ search.title|default('') }}"
                           placeholder="Enter book title..." class="form-control">
                </div>
            </div>
            <div class="search-actions">
                <button type="submit" class="btn-base btn-search">🔍 Search</button>
                <a href="{{ path('app_dashboard_reading_log') }}" class="btn-base btn-clear">🗑️ Clear</a>
            </div>
            <input type="hidden" name="limit" value="{{ pagination.items_per_page|default(20) }}">
        </form>
        {{ pagination.total_items }} {{ pagination.total_items == 1 ? 'entry' : 'entries' }} found
    </div>

    <table class="table modern-table">
        <thead>
            <tr>
                <th>Book</th>
                <th>Start Date</th>
                <th>Finish Date</th>
                <th>Rating</th>
                <th>Notes</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for reaLog in readLogs %}
            {% if reaLog is not null and reaLog is not empty %}
            <tr>
                <td>{{ reaLog.book.title ?? '' }}</td>
                <td class="purchase-date">{{ reaLog.startDate ? reaLog.startDate|date('Y-m-d') : '' }}</td>
                <td class="purchase-date">{{ reaLog.finishDate ? reaLog.finishDate|date('Y-m-d') : '' }}</td>
                <td>
                    {% if reaLog.rating is not null and reaLog.rating > 0 %}
                        {% for i in 1..reaLog.rating %}
                            ⭐
                        {% endfor %}
                    {% else %}
                        <span class="no-rating">No rating</span>
                    {% endif %}
                </td>
                <td>{{ reaLog.notes ?? '' }}</td>
                <td>
                    {% if reaLog.id is not null %}
                    <a href="{{ path('app_read_log_show', {'id': reaLog.id}) }}" class="action-btn btn-show">👁 Show</a>
                    <a href="{{ path('app_read_log_edit', {'id': reaLog.id, page: pagination.current_page|default(1), limit: pagination.items_per_page|default(20)}) }}" class="action-btn btn-edit">✏️ Edit</a>
                    <form method="post" action="{{ path('app_read_log_delete', {'id': reaLog.id, page: pagination.current_page|default(1), limit: pagination.items_per_page|default(20)}) }}" onsubmit="return confirm('Are you sure you want to delete this reading log entry?');" style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reaLog.id) }}">
                        <button type="submit" class="action-btn btn-delete-list">🗑️ Delete</button>
                    </form>
                    {% endif %}
                </td>
            </tr>
            {% endif %}
        {% else %}
            <tr>
                <td colspan="6" class="no-records">📖 No reading log entries found. Start tracking your reading!</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <!-- Pagination Controls -->
    {{ include('components/pagination.html.twig', {
        'route_name': 'app_dashboard_reading_log',
        'route_params': {
            title: search.title|default('')
        } | filter(v => v is not empty),
        'item_name': 'entries'
    }) }}
</div>
{% endblock %}
