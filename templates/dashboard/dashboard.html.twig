{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/dashboard.css') }}">
{% endblock %}

<div class="content-header">
    <h1>Dashboard</h1>
</div>

<div class="dashboard-content">
    <div class="dashboard-card card-reading">
        <h3>Reading now:</h3>
        <ul>
            {% for book in booksReadingNow %}
                <li>{{ book.title }}</li>
            {% endfor %}
        </ul>
    </div>
</div>

<div class="dashboard-content" style="margin-top: 20px">
    <div class="dashboard-card card-finished">
        <h3>Books read this year ({{ currentYear }})</h3>
        <ul>
        {% for bookName in booksReadCurrentYear %}
            <li>{{ bookName }}</li>
        {% endfor %}
        </ul>
    </div>
    <div class="dashboard-card">
        <h3>Statistics for this year ({{ currentYear }})</h3>
        You have read <span class="highlight-stat">{{ booksReadCurrentYearCount }} books</span>; <br>
        Meaning <span class="highlight-stat">{{ pages }} pages</span> in total; <br>
        At an average reading speed of <span class="highlight-stat">{{ avgDays }} days</span> per book; <br>
    </div>
</div>

<div class="dashboard-content" style="margin-top: 20px">
    <div class="dashboard-card">
        <h3>Total Statistics</h3>
        <ul>
            <li>Your library has a total of <span class="highlight-stat">{{ librarySize }}</span> books </li>
            <li>You have read <span class="highlight-stat">{{ totalFinishedBooks }}</span> books of your library</li>
            <li>Which represent <span class="highlight-stat">{{ totalReadPercentage }}%</span> of the total </li>
            <li>You have <span class="highlight-stat">{{ librarySize - totalFinishedBooks }}</span> books waiting to be read</li>
        </ul>
    </div>
</div>

<div class="dashboard-content" style="margin-top: 20px">
    <div class="dashboard-card">
        <h3>New books on the shelf this year ({{ currentYear }}) </h3>
        <ul>
            <li>The library has received {{ booksBroughtCurrentYearCount }} books: </li>
            <ul>
                {% for book in booksBroughtCurrentYear %}
                    <li>{{ book.title }}
                        {% if book.readLogs.count() %}
                            {% if book.readLogs[0].getFinishDate() == null %}
                                <span class="highlight-current-status">(reading now)</span>
                            {% else %}
                                <span class="highlight-current-status">(done)</span>
                            {% endif %}
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </ul>
    </div>
    <div class="dashboard-card">
        <h3>Books brought to your shelf last year ({{ currentYear - 1 }}) </h3>
        <ul>
            <li>The library has received {{ booksBroughtPreviousYearCount }} books: </li>
            <ul>
                {% set totalPreviousYearReadCount = 0 %}
                {% for book in booksBroughtPreviousYearRead %}
                    <li>{{ book.title }}
                        {% if book.readLogs[0].getFinishDate() == null %}
                            <span class="highlight-current-status">(reading now)</span>
                        {% else %}
                            {% set totalPreviousYearReadCount =  totalPreviousYearReadCount + 1 %}
                            <span class="highlight-current-status">(done)</span>
                        {% endif %}
                    </li>
                {% endfor %}
                {% for book in booksBroughtPreviousYearUnread %}
                    <li>{{ book.title }} <span class="highlight-current-status"></span> </li>
                {% endfor %}
            </ul>
        </ul>
        So you have read {{ totalPreviousYearReadCount }} books from this list
        {% if booksBroughtPreviousYearCount > 0 %}
            ({{ totalPreviousYearReadCount * 100 / booksBroughtPreviousYearCount }}%)
        {% else %}
            0%
        {% endif %}.
    </div>
</div>
